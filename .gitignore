*.pyc
lab/repos/
lab/swebench_repos/
lab/scala_repos/
# NOTE: lab/swebench_lite.parquet + lab/swebench_verified_heldout.parquet are
# COMMITTED (the gold data every published metric is scored against); do not
# re-add a lab/*.parquet ignore without a fetch script replacing them.
.venv/
.roust/
.venv-pkg/
roust-rs/target/
err.log
explain.log
out.json
lab/contextbench_repos/

# Generated at release time by npm/prepare-platform-package.mjs.
# The negation matters: npm/roust-cli/ is the tracked main package and the
# glob above would otherwise swallow it (and silently drop its version bumps).
npm/roust-*/
!npm/roust-cli/

# docs site build output
_site/
node_modules/
npm/roust-cli/README.md
