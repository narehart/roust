{
  "name": "roust-cli",
  "version": "0.3.1",
  "description": "Recall-first code retrieval for coding agents: one ranked, token-budgeted bundle of relevant code per query, across Python, JS/TS, Java, Go, Rust, C and C++. No model, no embeddings, no API key. Installs the roust binary.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narehart/roust.git"
  },
  "homepage": "https://github.com/narehart/roust#readme",
  "bugs": {
    "url": "https://github.com/narehart/roust/issues"
  },
  "keywords": [
    "code-search",
    "retrieval",
    "bm25",
    "coding-agent",
    "context",
    "localization",
    "tree-sitter",
    "rust",
    "cli"
  ],
  "bin": {
    "roust": "bin/roust.mjs"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "roust-darwin-arm64": "0.3.1",
    "roust-darwin-x64": "0.3.1",
    "roust-linux-arm64": "0.3.1",
    "roust-linux-x64": "0.3.1",
    "roust-win32-x64": "0.3.1"
  }
}
